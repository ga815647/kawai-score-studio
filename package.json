{
  "name": "kawai-score-studio",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "visual": "npx --yes @playwright/test@1.55.0 test tests/visual.spec.mjs",
    "check": "npm run validate && npm run build && npm test",
    "check:visual": "npm run check && npm run visual"
  },
  "dependencies": {
    "vexflow": "5.0.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0"
  },
  "engines": {
    "node": ">=20"
  }
}
